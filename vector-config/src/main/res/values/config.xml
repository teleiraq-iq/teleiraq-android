<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- "app_name" is now defined in build.gradle -->

    <!-- server urls -->
    <string name="matrix_org_server_url" translatable="false">https://im.teleiraq.com</string>

    <!-- Rageshake configuration -->
    <!--
        Bug reporting is disabled entirely via Config.ENABLE_BUG_REPORT, because this fork has no
        rageshake server of its own. These are deliberately left empty rather than pointing at
        Element's server: uploading TeleIraq users' logs, screenshots and crash traces to a third
        party is not acceptable. Fill them in with a TeleIraq endpoint before re-enabling the flag.
     -->
    <string name="bug_report_url" translatable="false"></string>
    <string name="bug_report_app_name" translatable="false"></string>
    <string name="bug_report_auto_uisi_app_name" translatable="false"></string>

    <!--
        Pusher config for the application
        https://im.teleiraq.com/docs/spec/client_server/r0.4.0#id128
     -->

    <!-- Note: pusher_http_url should have path '/_matrix/push/v1/notify' -->
    <!-- It is the push gateway for FCM embedded distributor -->
    <string name="pusher_http_url" translatable="false">https://push.teleiraq.com/_matrix/push/v1/notify</string>
    <!-- Note: default_push_gateway_http_url should have path '/_matrix/push/v1/notify' -->
    <!-- It is the push gateway for UnifiedPush -->
    <string name="default_push_gateway_http_url" translatable="false">https://push.teleiraq.com/_matrix/push/v1/notify</string>
    <!-- Note: pusher_app_id cannot exceed 64 chars -->
    <string name="pusher_app_id" translatable="false">iq.teleiraq.app.android</string>

    <!-- preferred jitsi domain -->
    <string name="preferred_jitsi_domain" translatable="false">jitsi.teleiraq.com</string>

    <string-array name="room_directory_servers" translatable="false">
        <item>im.teleiraq.com</item>
        <item>gitter.im</item>
    </string-array>

    <!-- Permalink config -->
    <!--
        There is no TeleIraq web client, so no web host's links need to be intercepted. Element's
        own hosts were removed: they are not this deployment, and claiming them made the app offer
        itself as a handler for element.io links. matrix.to links and the element: scheme are still
        handled, see the PermalinkHandlerActivity alias in the manifest.
     -->
    <string-array name="permalink_supported_hosts" translatable="false" />

</resources>
